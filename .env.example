# MediGuide AI Environment Configuration Template
# Copy this file to .env and customize values for your environment.

# Flask settings
FLASK_ENV=development
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production

# Database configuration (defaults to local SQLite instance)
# For PostgreSQL: postgresql://username:password@localhost:5432/mediguide
DATABASE_URL=sqlite:///instance/mediguide.db

# Security
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False

# Rate limiting storage (defaults to in-memory)
# RATELIMIT_STORAGE_URI=memory://
