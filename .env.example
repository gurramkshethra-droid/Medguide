# MediGuide AI Environment Configuration Template
# Copy this file to .env and customize values for your environment.

# Flask settings
FLASK_ENV=development
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production

# Database configuration. Default in config.py is the existing mediguide.db
# file in this folder. Do not point this at a new empty file unless you mean to.
# For PostgreSQL later: postgresql://username:password@localhost:5432/mediguide
# DATABASE_URL=sqlite:///mediguide.db

# Security
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False

# Rate limiting storage (defaults to in-memory)
# RATELIMIT_STORAGE_URI=memory://
